# ─────────────────────────────────────────────────────────────────────────────
# AgroControl Campo — variables de entorno
# Copia este archivo a `.env.local` y completa los valores. NO subir secretos.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Fase 4). Proyecto propio de la app (ver ADR-0001).
#   URL del proyecto, p. ej. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
#   anon key (pública; el acceso lo controla RLS). NO usar la service_role aquí.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (Fase 5, observabilidad). Opcional hasta entonces.
# NEXT_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Hub — Copernicus Data Space Ecosystem (ADR-0022).
# Capa satelital Sentinel-2 RECIENTE e índices (NDVI, color real) por WMS, como
# complemento del mosaico anual sin nubes de EOX (que no necesita config).
# OPCIONAL: sin instance ID, la capa y su toggle no aparecen.
#
# Alta gratuita: regístrate en https://dataspace.copernicus.eu y en el panel de
# Sentinel Hub crea una "configuración" OGC (instance); copia su Instance ID.
# Restringe el dominio de esa configuración a tu despliegue: el instance ID va
# en la URL del navegador y consume tu cuota (no es un secreto de credencial).
# ─────────────────────────────────────────────────────────────────────────────
#   Instance ID de la configuración OGC (autentica las peticiones WMS de CDSE).
NEXT_PUBLIC_SENTINELHUB_INSTANCE_ID=
#   Capas a exponer como toggles, separadas por coma (por defecto: NDVI,NDMI).
#   Cada entrada es el nombre EXACTO de la capa en tu instancia; opcional
#   "ID:Etiqueta" para el texto del toggle (p. ej. NDVI,NDMI:Humedad del cultivo).
#   Índices con leyenda de color propia: NDVI, NDMI, EVI.
# NEXT_PUBLIC_SENTINELHUB_LAYERS=NDVI,NDMI,EVI
#   Nubosidad máxima por tesela, 0–100 (por defecto: 20).
# NEXT_PUBLIC_SENTINELHUB_MAXCC=20

# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Hub — credenciales OAuth para el CALENDARIO de fechas de paso del
# satélite (Catalog API, ADR-0025). SON SECRETAS Y DE SERVIDOR: sin prefijo
# NEXT_PUBLIC (nunca llegan al navegador; solo las usa /api/sentinel-dates).
# Opcional: sin ellas, el calendario funciona pero no marca los días con imagen.
# Créalas en el panel de CDSE: User settings → OAuth clients → Create.
# ─────────────────────────────────────────────────────────────────────────────
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
